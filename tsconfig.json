{
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext", "module": "Preserve", "moduleResolution": "bundler",
    "jsx": "preserve", "jsxImportSource": "@solidjs/web", "types": ["bun"],
    "allowJs": true, "checkJs": false, "noEmit": true, "strict": true,
    "skipLibCheck": true, "noUncheckedIndexedAccess": true
  },
  "include": ["harness", "scripts", "tracks", "findings"],
  "exclude": ["node_modules", ".scratch", ".upstream", ".build"]
}
