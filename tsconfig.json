{
	"extends": "@celados/harness/tsconfig/bun.json",
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "Preserve",
		"jsx": "preserve",
		"jsxImportSource": "@solidjs/web",
		"allowJs": true,
		"checkJs": false,
		"noUncheckedIndexedAccess": true
	},
	"include": ["harness", "scripts", "tracks", "findings", "*.ts"],
	"exclude": ["node_modules", ".scratch", ".upstream", ".build"]
}
