@@ -0,0 +1,25 @@
+import { expect, it } from "vitest";
+import { action, createLoadingBoundary, createMemo, createRenderEffect, createRoot, createSignal, flush, latest } from "../src/index.js";
+
+it("a verdict-mounted boundary collects the child DOM render effect", async () => {
+  const [x, setX] = createSignal(0);
+  let screen: unknown, slot: unknown, inner: unknown;
+  createRoot(() => {
+    createRenderEffect(x, v => { screen = v; });
+    const conditionValue = createMemo(() => latest(x) > 0);
+    const condition = createMemo(conditionValue, { equals: (a, b) => !a === !b, sync: true });
+    const view = createMemo(() => condition() ? createLoadingBoundary(() => {
+      createRenderEffect(x, v => { inner = v; });
+      return "node";
+    }, () => "pending") : "closed", { sync: true });
+    createRenderEffect(() => { const result = view(); return typeof result === "function" ? result() : result; }, v => { slot = v; });
+  });
+  flush();
+  let release!: () => void;
+  const done = action(function* () { setX(1); yield new Promise<void>(r => { release = r; }); })();
+  for (let i=0;i<3;i++) { await new Promise(r => setTimeout(r, 0)); flush(); }
+  const during = [screen, slot, inner];
+  release(); await done; flush();
+  expect(during).toEqual([0, "pending", undefined]);
+  expect([screen, slot, inner]).toEqual([1, "node", 1]);
+});
